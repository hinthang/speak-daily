function getDialogs() {
  const ss = getSS_();
  ensureSheet_(ss, SHEET_DLG,
    ['question', 'q_reading', 'q_thai', 'answer', 'a_reading', 'a_thai', 'topic'], SEED_DIALOG);
  return readTable_(SHEET_DLG).map(r => ({
    q: String(r[0]), qr: String(r[1]), qt: String(r[2]),
    a: String(r[3]), ar: String(r[4]), at: String(r[5]), topic: String(r[6] || '')
  }));
}
