// ใช้ตอนเพิ่มแถวใหม่: คืนแถว 5 คอลัมน์ [english, reading, thai, cat/level, tip]
function applyPron_(row, map) {
  const fix = map[row[0]] || map[String(row[0]).toLowerCase()];
  return [row[0], fix ? fix[0] : row[1], row[2], row[3], fix ? fix[1] : (row[4] || '')];
}

// รันครั้งเดียวหลังวางไฟล์นี้ (หรือทุกครั้งที่แก้ PRON_*) เพื่ออัปเดตคำอ่านใน Sheet
function updateReadings() {
  const ss = getSS_();
  let n = 0;
  [[SHEET_VOCAB, PRON_VOCAB], [SHEET_SENT, PRON_SENT]].forEach(([name, map]) => {
    const sh = ss.getSheetByName(name);
    if (!sh) return;
    sh.getRange(1, 5).setValue('tip').setFontWeight('bold');
    const last = sh.getLastRow();
    if (last < 2) return;
    const rng = sh.getRange(2, 1, last - 1, 5);
    const rows = rng.getValues().map(r => {
      const out = applyPron_(r, map);
      if (out[1] !== r[1] || out[4] !== r[4]) n++;
      return out;
    });
    rng.setValues(rows);
  });
  Logger.log('อัปเดตคำอ่าน ' + n + ' แถว');
}
